import pandas as pd
import geopandas as gpd
import psycopg2
import folium
from shapely.geometry import Point
from geoalchemy2 import Geometry
from sqlalchemy import create_engine

# Параметри підключення до бази даних PostgreSQL
db_params = {
    "dbname": "bus_stops_db",  
    "user": "postgres",
    "password": "112233",
    "host": "localhost",
    "port": 5432,
}

# Підключення до PostgreSQL через psycopg2
conn = psycopg2.connect(**db_params)
cursor = conn.cursor()

# Завантаження GeoJSON файлу з межами Галицького району
district_geojson_path = "/home/volodymir/Стільниця/haldistrict1.geojson"
district_gdf = gpd.read_file(district_geojson_path)

# Перевірка даних (вивести межі району)
print(district_gdf.head())

# Отримуємо геометрію району в форматі WKT для збереження в базі
district_geom_wkt = district_gdf.geometry.iloc[0].wkt

# Створення таблиці для зупинок, якщо її немає
cursor.execute("""
    CREATE TABLE IF NOT EXISTS lvivhal1 (
        stop_id SERIAL PRIMARY KEY,
        settlement CHARACTER VARYING(50),
        stop_code CHARACTER VARYING(10),
        stop_name CHARACTER VARYING(100),
        stop_desc CHARACTER VARYING(200),
        stop_lat DOUBLE PRECISION,
        stop_lon DOUBLE PRECISION,
        geom GEOMETRY(Point, 4326)
    );
""")
conn.commit()

# Створення таблиці для збереження геометрії району (якщо її немає)
cursor.execute("""
    CREATE TABLE IF NOT EXISTS haldistrict (
        district_id SERIAL PRIMARY KEY,
        name CHARACTER VARYING(100),
        geom GEOMETRY(Polygon, 4326)
    );
""")
conn.commit()

# Видалення всіх записів для Галицького району перед вставкою нового (якщо є дублікат)
cursor.execute("""
    DELETE FROM haldistrict WHERE name = 'Галицький район';
""")
conn.commit()

# Вставка геометрії району в таблицю (з гарантією, що буде тільки один запис для Галицького району)
cursor.execute("""
    INSERT INTO haldistrict (name, geom)
    VALUES (%s, ST_GeomFromText(%s, 4326))
    """, ("Галицький район", district_geom_wkt))
conn.commit()

# Завантаження зупинок Львова з CSV файлу
file_path_csv = '/home/volodymir/Документи/зупинки Львова/local_file.csv'
df = pd.read_csv(file_path_csv, sep=";", encoding="windows-1251")
df = df[['stop_id', 'settlement', 'stop_code', 'stop_name', 'stop_desc', 'stop_lat', 'stop_lon']]

# Створення GeoDataFrame для зупинок Львова
geometry = [Point(xy) for xy in zip(df['stop_lon'], df['stop_lat'])]
geo_df = gpd.GeoDataFrame(df, geometry=geometry, crs="EPSG:4326")

# Додавання зупинок у таблицю lvivhal1
for _, stop in geo_df.iterrows():
    cursor.execute("""
        INSERT INTO lvivhal1 (settlement, stop_code, stop_name, stop_desc, stop_lat, stop_lon, geom)
        VALUES (%s, %s, %s, %s, %s, %s, ST_GeomFromText(%s, 4326));
    """, (
        stop['settlement'], stop['stop_code'], stop['stop_name'], stop['stop_desc'],
        stop['stop_lat'], stop['stop_lon'], f"POINT({stop['stop_lon']} {stop['stop_lat']})"
    ))
conn.commit()

# Запит для вибору зупинок, що знаходяться в межах Галицького району
# Запит для вибору зупинок, що знаходяться в межах Галицького району
cursor.execute("""
    SELECT stop_id, stop_name, stop_lat, stop_lon, ST_AsText(geom) 
    FROM lvivhal1 
    WHERE ST_Within(geom, (SELECT geom FROM haldistrict WHERE name = 'Галицький район' LIMIT 1));
""")


# Отримання результатів запиту
stops_within_district = cursor.fetchall()

# Виведення результатів
if stops_within_district:
    print(f"Зупинки у Галицькому районі:")
    for stop in stops_within_district:
        print(stop)
else:
    print("Не знайдено зупинок у межах Галицького району.")

# Закриття підключення до бази даних
cursor.close()
conn.close()

# Створення карти зупинок Львова
lviv_lat = 49.8397  # координати Львова
lviv_lon = 24.0297

m = folium.Map(location=[lviv_lat, lviv_lon], zoom_start=12)

# Додавання зупинок на карту
for _, row in geo_df.iterrows():
    folium.Marker([row['stop_lat'], row['stop_lon']], popup=row['stop_name']).add_to(m)

# Збереження карти в HTML
m.save('/home/volodymir/Документи/lviv_stops_map.html')
print("Карта зупинок Львова збережена у lviv_stops_map.html.")
